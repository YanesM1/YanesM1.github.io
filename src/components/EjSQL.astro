</div>

<div class="ejercicio-card">
    <div class="ejercicio-header">
        <h3>Ejercicio AR-10</h3>
        <span>INNER JOIN + SUBCONSULTA + FETCH FIRST</span>
    </div>

    <div class="ejercicio-contenido">
        <h4>Enunciado</h4>
        <p>
            Mostrar el nombre y el documento de los 3 clientes que hayan realizado
            más préstamos. Ordenar el resultado de forma descendente por cantidad
            de préstamos.
        </p>

        <h4>Álgebra relacional</h4>
        <pre><code><escape>π_</escape>{'{'}<escape>primer_nombre, documento_cliente</escape>{'}'}<escape> (τ_</escape>{'{'}<escape>total_prestamos DESC</escape>{'}'}<escape> (𝒢_</escape>{'{'}<escape>documento_cliente, primer_nombre, COUNT(id_prestamo) → total_prestamos</escape>{'}'}<escape> (CLIENTE ⋈_</escape>{'{'}<escape>CLIENTE.documento_cliente = PRESTAMO.documento_cliente</escape>{'}'}<escape> PRESTAMO)))</escape></code></pre>

        <h4>Consulta SQL equivalente</h4>
        <pre><code><escape>USE proyecto_db1;

SELECT C.primer_nombre, C.documento_cliente,
       COUNT(P.id_prestamo) AS total_prestamos
FROM CLIENTE C
INNER JOIN PRESTAMO P
    ON C.documento_cliente = P.documento_cliente
GROUP BY C.primer_nombre, C.documento_cliente
ORDER BY total_prestamos DESC
FETCH FIRST 3 ROWS ONLY;</escape></code></pre>
    </div>
</div>




<!-- EJERCICIO AR-12 -->

<div class="ejercicio-card">
    <div class="ejercicio-header">
        <h3>Ejercicio AR-12</h3>
        <span>Proyección + Selección + Unión</span>
    </div>

    <div class="ejercicio-contenido">
        <h4>Enunciado</h4>
        <p>
            Mostrar el nombre de los juegos de mesa de la categoría "Estrategia"
            junto con el nombre de los juegos de la categoría "Familiar".
            Unir ambos conjuntos en un solo resultado.
        </p>

        <h4>Álgebra relacional</h4>
        <pre><code>
            π_{'{'}nombre{'}'} (σ_{'{'}categoria = 'Estrategia'{'}'} (JUEGO_MESA ⋈_{'{'}JUEGO_MESA.num_serie = CATEGORIA.num_serie{'}'} CATEGORIA))

            ∪
            π_{'{'}nombre{'}'} (σ_{'{'}categoria = 'Familiar'{'}'} (JUEGO_MESA ⋈_{'{'}JUEGO_MESA.num_serie = CATEGORIA.num_serie{'}'} CATEGORIA))
        </code></pre>


        <h4>Consulta SQL equivalente</h4>
        <pre><code><escape>USE proyecto_db1;

            SELECT J.nombre
            FROM JUEGO_MESA J
            INNER JOIN CATEGORIA C
            ON J.num_serie = C.num_serie
            WHERE C.categoria = 'Estrategia'

            UNION

            SELECT J.nombre
            FROM JUEGO_MESA J
            INNER JOIN CATEGORIA C
            ON J.num_serie = C.num_serie
            WHERE C.categoria = 'Familiar';
        </escape></code></pre>
    </div>
</div>

