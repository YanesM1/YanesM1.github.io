<!-- TARJETA DE EJERCICIOS VARIOS -->

<div class="ejercicio-card">

    <div class="ejercicio-header">
        <h3>Ejercicios varios de SQL</h3>
        <span>Consultas, operadores, JOIN y funciones de agregación</span>
    </div>

    <div class="ejercicio-contenido">

        <!-- 1. SELECCIONES -->

        <h4>1. Selecciones (WHERE)</h4>
        <p>Consultar registros aplicando diferentes condiciones.</p>

        <pre><code><escape>USE proyecto_db1;

-- 1. Consultar todos los registros
SELECT *
FROM HR.EMPLOYEES;

-- 2. Buscar por nombre
SELECT *
FROM HR.EMPLOYEES
WHERE first_name = 'Steven';

-- 3. Buscar por apellido
SELECT *
FROM HR.EMPLOYEES
WHERE last_name = 'King';

-- 4. Salario mayor que 10000
SELECT *
FROM HR.EMPLOYEES
WHERE salary > 10000;

-- 5. Empleados del departamento 90
SELECT *
FROM HR.EMPLOYEES
WHERE department_id = 90;

-- 6. Empleados con cargo IT_PROG
SELECT *
FROM HR.EMPLOYEES
WHERE job_id = 'IT_PROG';

-- 7. Empleados cuyo jefe tiene ID 103
SELECT *
FROM HR.EMPLOYEES
WHERE manager_id = 103;

-- 8. Salario menor que 5000
SELECT *
FROM HR.EMPLOYEES
WHERE salary < 5000;

-- 9. Empleados con cargo FI_ACCOUNT
SELECT last_name, salary, job_id
FROM HR.EMPLOYEES
WHERE job_id = 'FI_ACCOUNT';

-- 10. Empleados contratados después del 1 de enero de 2015
SELECT *
FROM HR.EMPLOYEES
WHERE hire_date > DATE '2015-01-01';

-- 11. Comisión diferente de 0.2
SELECT *
FROM HR.EMPLOYEES
WHERE commission_pct != 0.2;

-- 12. Salarios entre 8000 y 12000
SELECT *
FROM HR.EMPLOYEES
WHERE salary >= 8000 AND salary <= 12000;

-- 13. Departamento 100 y salario mayor que 10000
SELECT *
FROM HR.EMPLOYEES
WHERE department_id = 100 AND salary > 10000;</escape></code></pre>


        <!-- 2. VALORES NULOS -->

        <h4>2. Valores nulos (NULL)</h4>
        <p>Consultar empleados que tienen o no tienen comisión.</p>

        <pre><code><escape>-- 1. Empleados sin comisión
SELECT *
FROM HR.EMPLOYEES
WHERE commission_pct IS NULL;

-- 2. Empleados con comisión
SELECT *
FROM HR.EMPLOYEES
WHERE commission_pct IS NOT NULL;

-- 3. Utilizando NOT
SELECT *
FROM HR.EMPLOYEES
WHERE NOT (commission_pct IS NULL);</escape></code></pre>


        <!-- 3. DISTINCT -->

        <h4>3. DISTINCT (Eliminar duplicados)</h4>
        <p>Consultar departamentos sin repetir nombres.</p>

        <pre><code><escape>SELECT DISTINCT department_name
FROM HR.DEPARTMENTS;</escape></code></pre>


        <!-- 4. PROYECCIONES -->

        <h4>4. Proyecciones (SELECT)</h4>
        <p>Seleccionar columnas específicas de la tabla EMPLOYEES.</p>

        <pre><code><escape>-- 1. Mostrar nombres y apellidos
SELECT first_name, last_name
FROM HR.EMPLOYEES;

-- 2. Mostrar correos electrónicos
SELECT email
FROM HR.EMPLOYEES;

-- 3. Nombres, apellidos y departamento 50
SELECT first_name, last_name, department_id
FROM HR.EMPLOYEES
WHERE department_id = 50;

-- 4. Cambiar nombres de columnas con AS
SELECT first_name AS nombre, last_name AS apellido
FROM HR.EMPLOYEES;

-- 5. Proyección con selección y alias
SELECT employee_id AS id_emp,
       hire_date AS fecha_contratacion,
       job_id
FROM HR.EMPLOYEES
WHERE job_id = 'IT_PROG';

-- 6. Nombres, apellidos y correo
SELECT first_name, last_name, email
FROM HR.EMPLOYEES;

-- 7. Apellidos y fechas de contratación
SELECT last_name, hire_date
FROM HR.EMPLOYEES;

-- 8. Identificador, apellido y cargo
SELECT employee_id, last_name, job_id
FROM HR.EMPLOYEES;

-- 9. Apellidos y salarios del departamento 60
SELECT last_name, salary
FROM HR.EMPLOYEES
WHERE department_id = 60;

-- 10. Nombres y correos de empleados IT_PROG
SELECT first_name, email
FROM HR.EMPLOYEES
WHERE job_id = 'IT_PROG';

-- 11. Apellidos y fechas de empleados con salario mayor a 10000
SELECT last_name, hire_date
FROM HR.EMPLOYEES
WHERE salary > 10000;</escape></code></pre>


        <!-- 5. OPERADORES NOT -->

        <h4>5. Operador NOT y negaciones</h4>
        <p>Aplicar condiciones negadas a los registros.</p>

        <pre><code><escape>-- 1. Apellido y salario de empleados que no son IT_PROG
SELECT last_name, salary
FROM HR.EMPLOYEES
WHERE NOT (job_id = 'IT_PROG');

-- 2. Apellidos de empleados que no tienen comisión
SELECT last_name
FROM HR.EMPLOYEES
WHERE NOT (commission_pct IS NULL);

-- Forma equivalente
SELECT last_name
FROM HR.EMPLOYEES
WHERE commission_pct IS NOT NULL;

-- 3. Empleados que no son IT_PROG ni pertenecen al departamento 100
SELECT last_name, job_id
FROM HR.EMPLOYEES
WHERE NOT (job_id = 'IT_PROG')
AND NOT (department_id = 100);

-- 4. Negación de una condición compuesta
SELECT last_name, job_id
FROM HR.EMPLOYEES
WHERE NOT (job_id = 'IT_PROG' AND salary > 5000);

-- 5. Empleados que no son IT_PROG y ganan 5000 o menos
SELECT last_name, job_id
FROM HR.EMPLOYEES
WHERE job_id != 'IT_PROG'
AND salary <= 5000;</escape></code></pre>


        <!-- 6. INTERSECCIÓN -->

        <h4>6. Intersección (INTERSECT)</h4>
        <p>Consultar registros que cumplen simultáneamente dos condiciones o pertenecen a ambos conjuntos.</p>

        <pre><code><escape>-- 1. Empleados IT_PROG del departamento 60
SELECT last_name, job_id
FROM HR.EMPLOYEES
WHERE job_id = 'IT_PROG'
AND department_id = 60;

-- 2. Apellidos de empleados que tienen comisión y ganan más de 10000
SELECT last_name
FROM HR.EMPLOYEES
WHERE commission_pct IS NOT NULL
INTERSECT
SELECT last_name
FROM HR.EMPLOYEES
WHERE salary > 10000;

-- Forma equivalente utilizando AND
SELECT last_name
FROM HR.EMPLOYEES
WHERE commission_pct IS NOT NULL
AND salary > 10000;

-- 3. Apellido y departamento de empleados que ganan más de 10000
-- y pertenecen al departamento 100
SELECT last_name, department_id
FROM HR.EMPLOYEES
WHERE salary > 10000
INTERSECT
SELECT last_name, department_id
FROM HR.EMPLOYEES
WHERE department_id = 100;

-- Forma equivalente utilizando AND
SELECT last_name, department_id
FROM HR.EMPLOYEES
WHERE salary > 10000
AND department_id = 100;</escape></code></pre>


        <!-- 7. COMBINACIONES -->

        <h4>7. Combinaciones de condiciones (AND y OR)</h4>
        <p>Combinar varias condiciones utilizando operadores lógicos.</p>

        <pre><code><escape>-- 1. Empleados que ganan más de 10000 o tienen comisión,
-- pero que no son IT_PROG
SELECT last_name, salary
FROM HR.EMPLOYEES
WHERE (salary > 10000 OR commission_pct IS NOT NULL)
AND job_id != 'IT_PROG';

-- 2. Empleados IT_PROG o del departamento 100,
-- que no tienen comisión
SELECT last_name
FROM HR.EMPLOYEES
WHERE (job_id = 'IT_PROG' OR department_id = 100)
AND commission_pct IS NULL;</escape></code></pre>


        <!-- 8. CONCATENACIÓN -->

        <h4>8. Concatenación de cadenas</h4>
        <p>Unir diferentes valores de texto utilizando el operador ||.</p>

        <pre><code><escape>-- 1. Apellido y cargo del empleado
SELECT last_name || ' is a ' || job_id AS "Employee Details"
FROM HR.EMPLOYEES;

-- 2. Nombre completo
SELECT last_name || ', ' || first_name AS nombre_completo
FROM HR.EMPLOYEES;

-- 3. Concatenación utilizando comillas simples escapadas
SELECT 'El empleado O''Connell gana ' || salary AS detalle
FROM HR.EMPLOYEES
WHERE employee_id = 198;

-- 4. Concatenación utilizando q-quote
SELECT q'[El empleado O'Connell gana ]' || salary AS detalle
FROM HR.EMPLOYEES
WHERE employee_id = 198;</escape></code></pre>


        <!-- 9. PATRONES -->

        <h4>9. Patrones y caracteres (LIKE)</h4>
        <p>
            Mostrar el apellido, el puesto y el salario de los empleados cuyo apellido
            contenga una "a", que ganen más de 4000, ordenados por salario de mayor a menor.
        </p>

        <pre><code><escape>SELECT last_name, job_id, salary
FROM HR.EMPLOYEES
WHERE last_name LIKE '%A%'
AND salary > 4000
ORDER BY salary DESC;</escape></code></pre>


        <!-- 10. OPERACIONES DE CONJUNTOS -->

        <h4>10. Operaciones de conjuntos (UNION, INTERSECT y MINUS)</h4>
        <p>Combinar resultados, encontrar coincidencias y obtener diferencias entre conjuntos.</p>

        <pre><code><escape>-- 1. Departamentos que aparecen en EMPLOYEES o DEPARTMENTS
SELECT department_id
FROM HR.EMPLOYEES
UNION
SELECT department_id
FROM HR.DEPARTMENTS;

-- 2. Departamentos existentes en DEPARTMENTS que tienen empleados
SELECT department_id
FROM HR.DEPARTMENTS
INTERSECT
SELECT department_id
FROM HR.EMPLOYEES;

-- 3. Departamentos que existen pero no tienen empleados
SELECT department_id
FROM HR.DEPARTMENTS
MINUS
SELECT department_id
FROM HR.EMPLOYEES;

-- 4. Lista de ciudades y países sin repetir valores
SELECT country_name
FROM HR.COUNTRIES
UNION
SELECT city
FROM HR.LOCATIONS;</escape></code></pre>


        <!-- 11. JOIN -->

        <h4>11. JOIN</h4>
        <p>Unir tablas utilizando las columnas que tienen el mismo nombre.</p>

        <pre><code><escape>SELECT department_name, last_name
FROM HR.DEPARTMENTS
NATURAL JOIN HR.EMPLOYEES;</escape></code></pre>


        <!-- 12. EQUIJOIN -->

        <h4>12. Equijoin</h4>
        <p>Unir tablas mediante una condición de igualdad explícita.</p>

        <pre><code><escape>SELECT d.department_name, e.last_name
FROM HR.DEPARTMENTS d
JOIN HR.EMPLOYEES e
    ON d.department_id = e.department_id;</escape></code></pre>


        <!-- 13. THETA JOIN -->

        <h4>13. Theta-join</h4>
        <p>Unir tablas utilizando condiciones de comparación distintas de la igualdad.</p>

        <pre><code><escape>SELECT e.last_name, e.salary, j.job_title, j.min_salary
FROM HR.EMPLOYEES e
JOIN HR.JOBS j
    ON e.salary > j.min_salary;</escape></code></pre>


        <!-- 14. FUNCIONES DE AGREGACIÓN -->

        <h4>14. Funciones de agregación</h4>
        <p>Calcular valores estadísticos a partir de los salarios de los empleados.</p>

        <pre><code><escape>-- SUM(salary): suma de salarios, ignora valores nulos
-- AVG(salary): promedio de salarios no nulos
-- STDDEV(salary): desviación estándar muestral
-- COUNT(*): número total de filas
-- MIN(salary): salario más bajo
-- MAX(salary): salario más alto

SELECT SUM(salary) AS total,
       AVG(salary) AS promedio,
       STDDEV(salary) AS desviacion,
       COUNT(*) AS cuantos,
       MIN(salary) AS minimo,
       MAX(salary) AS maximo
FROM HR.EMPLOYEES;</escape></code></pre>


        <!-- 15. PRODUCTO CARTESIANO -->

        <h4>15. Producto cartesiano</h4>
        <p>Generar todas las combinaciones posibles entre los registros de dos tablas.</p>

        <pre><code><escape>-- 1. Empleados y departamentos
SELECT E.first_name, D.department_name
FROM HR.EMPLOYEES E
CROSS JOIN HR.DEPARTMENTS D;

-- 2. Empleados y países
SELECT E.first_name, C.country_name
FROM HR.EMPLOYEES E
CROSS JOIN HR.COUNTRIES C;</escape></code></pre>


        <!-- 16. CONSULTA Y CREACIÓN DE TABLA -->

        <h4>16. Consulta y creación de tablas</h4>
        <p>Consultar los registros de LOCATIONS y crear una copia de la tabla.</p>

        <pre><code><escape>-- 1. Consultar todos los registros
SELECT *
FROM HR.LOCATIONS;

-- 2. Crear una copia de LOCATIONS
CREATE TABLE LOCATIONS_C AS
SELECT *
FROM HR.LOCATIONS;</escape></code></pre>

    </div>
