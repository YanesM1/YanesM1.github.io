---
import Layout from "../layouts/Layout.astro";
import BannerAstroComponent from "../components/Banner.astro";
import HeaderTitleAstroComponent from "../components/Header-title.astro";

import Modelo1AstroComponent from "../components/Modelo1.astro";
import Modelo2AstroComponent from "../components/Modelo2.astro";
import Modelo3AstroComponent from "../components/Modelo3.astro";
import Modelo4AstroComponent from "../components/Modelo4.astro";
import Modelo5AstroComponent from "../components/Modelo5.astro";
import Modelo6AstroComponent from "../components/Modelo6.astro";
import Modelo7AstroComponent from "../components/Modelo7.astro";

import "../styles/modelado.css";
import "../styles/style.css";
---

<Layout title="Digital Portfolio">
  <div class="hero">
    <div class="hero__banner">
      <BannerAstroComponent />
    </div>

    <div class="hero__title">
      <HeaderTitleAstroComponent />
    </div>
  </div>

  <section class="modelado">
    <h1>Modelado</h1>

    <!-- EJERCICIO 1 -->

    <div class="evidencia">
      <h2>Ejercicio 1</h2>

      <iframe
        src="/evidencias/modelado/ejercicio-1.pdf"
        title="Evidencia de Modelado - Ejercicio 1"
      >
      </iframe>

      <a href="/evidencias/modelado/ejercicio-1.pdf" target="_blank">
        Abrir PDF en otra pestaña
      </a>
    </div>
  </section>

  <!-- =====================================================
         SOLUCIONES
         ===================================================== -->

  <div class="solution">
    <div class="modelado1__contenido">
      <Modelo1AstroComponent />
    </div>

    <iframe src="/evidencias/modelado/1.pdf" title="Solución Punto 1"> </iframe>

    <a href="/evidencias/modelado/1.pdf" target="_blank">
      Abrir PDF en otra pestaña
    </a>

    <div class="modelado2__contenido">
      <Modelo2AstroComponent />
    </div>

    <iframe src="/evidencias/modelado/2.pdf" title="Solución Punto 2"> </iframe>

    <a href="/evidencias/modelado/2.pdf" target="_blank">
      Abrir PDF en otra pestaña
    </a>

    <div class="modelado3__contenido">
      <Modelo3AstroComponent />
    </div>

    <iframe src="/evidencias/modelado/3.pdf" title="Solución Punto 3"> </iframe>

    <a href="/evidencias/modelado/3.pdf" target="_blank">
      Abrir PDF en otra pestaña
    </a>

    <div class="modelado4__contenido">
      <Modelo4AstroComponent />
    </div>

    <iframe
      src="/evidencias/modelado/5.pdf"
      title="Solución transformación a tablas"
    >
    </iframe>

    <a href="/evidencias/modelado/5.pdf" target="_blank">
      Abrir PDF en otra pestaña
    </a>

    <iframe
      src="/evidencias/modelado/4.pdf"
      title="Solución transformación a tablas"
    >
    </iframe>

    <a href="/evidencias/modelado/4.pdf" target="_blank">
      Abrir PDF en otra pestaña
    </a>
  </div>





  <div class="modelado5__contenido">
    <Modelo5AstroComponent />
  </div>

  <div class="solution">
    <iframe
      src="/evidencias/modelado/6-1.pdf"
      title="Modelo entidad relación extendido."
    >
    </iframe>

    <a href="/evidencias/modelado/6-1.pdf" target="_blank">
      Abrir PDF en otra pestaña
    </a>
  </div>




  <div class="modelado6__contenido">
    <Modelo6AstroComponent />
  </div>

  <div class="solution">
    <iframe
      src="/evidencias/modelado/6-2.pdf"
      title="Modelo reducido a tablas."
    >
    </iframe>

    <a href="/evidencias/modelado/6-2.pdf" target="_blank">
      Abrir PDF en otra pestaña
    </a>
  </div>


    <div class="modelado7__contenido">
        <Modelo7AstroComponent />
    </div>

</Layout>
