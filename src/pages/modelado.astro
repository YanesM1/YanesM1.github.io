---
import Layout from "../layouts/Layout.astro";
import BannerAstroComponent from "../components/Banner.astro";
import HeaderTitleAstroComponent from "../components/Header-title.astro";
import Modelo1AstroComponent from "../components/Modelo1.astro";
import Modelo2AstroComponent from "../components/Modelo2.astro";
import Modelo3AstroComponent from "../components/Modelo3.astro";
import "../styles/modelado.css";
import "../styles/style.css";
---

<Layout title="Digital Portfolio">

    <div class="hero">
        <div class="hero__banner">
            <BannerAstroComponent />
        </div>

        <div class="hero__title">
            <HeaderTitleAstroComponent />
        </div>
    </div>

    <section class="modelado">

        <h1>Modelado</h1>

        <div class="evidencia">

            <h2>Ejercicio 1</h2>

            <iframe
                src="/evidencias/modelado/ejercicio-1.pdf"
                title="Evidencia de Modelado - Ejercicio 1">
            </iframe>

            <a
                href="/evidencias/modelado/ejercicio-1.pdf"
                target="_blank"
            >
                Abrir PDF en otra pestaña
            </a>

        </div>

        <div class="modelado1__contenido">
            <Modelo1AstroComponent/>
        </div>
    </section>
    <div class=" solution">
        <h2>Punto 1</h2>
            <iframe
                src="/evidencias/modelado/1.pdf"
                title="Ejercicio 1">
            </iframe>

            <a
                href="/evidencias/modelado/1.pdf"
                target="_blank"
            >
                Abrir PDF en otra pestaña
            </a>
        <div class="modelado2__contenido">
            <Modelo2AstroComponent/>
        </div>
        <h2>Punto 2</h2>
            <iframe
                src="/evidencias/modelado/2.pdf"
                title="Ejercicio 1">
            </iframe>

            <a
                href="/evidencias/modelado/2.pdf"
                target="_blank"
            >
                Abrir PDF en otra pestaña
            </a>
        
         <div class="modelado3__contenido">
            <Modelo3AstroComponent/>
        </div>
        
            <h2>Punto 3</h2>
            <iframe
                src="/evidencias/modelado/3.pdf"
                title="Ejercicio 1">
            </iframe>

            <a
                href="/evidencias/modelado/3.pdf"
                target="_blank"
            >
                Abrir PDF en otra pestaña
            </a>
    </div>

</Layout>